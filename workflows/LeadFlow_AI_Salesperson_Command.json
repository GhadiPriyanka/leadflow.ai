        "jsCode": "const leads = $input.all();\n\nlet message = \"🔥 TOP 3 PRIORITY LEADS\\n\\n\";\n\nleads.forEach((item, index) => {\n  const lead = item.json;\n\n  message +=\n`${index + 1}. ${lead.Name || \"Unknown\"} (${lead.Lead_ID})\n🎯 Score: ${lead.Score}\n🚨 Priority: ${lead.Priority}\n💡 Intent: ${lead.Intent}\n📌 Action: ${lead.AI_Recommendation}\n\n`;\n});\n\nmessage += \"👉 Contact the highest-score lead first.\";\n\nreturn [{\n  json: {\n    message\n  }\n}];"
