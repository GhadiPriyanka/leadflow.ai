    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json);\n\n// Parse dd-mm-yyyy into a Date (or null)\nfunction parseDate(s) {\n  if (!s || typeof s !== 'string') return null;\n  const m = s.trim().match(/^(\\d{1,2})[-\\/](\\d{1,2})[-\\/](\\d{2,4})$/);\n  if (!m) return null;\n  let [, d, mo, y] = m;\n  if (y.length === 2) y = '20' + y;\n  const dt = new Date(Number(y), Number(mo) - 1, Number(d));\n  return isNaN(dt.getTime()) ? null : dt;\n}\n\nconst now = new Date();\nnow.setHours(0, 0, 0, 0);\n\n// A lead needs follow-up if its status is Follow-up/Contacted,\n// or it has a Next_Followup date that is today or in the past.\nconst due = leads.filter(lead => {\n  const status = String(lead.Status || '').toLowerCase();\n  const next = parseDate(lead.Next_Followup);\n  const statusMatch = status === 'follow-up' || status === 'followup' || status === 'contacted';\n  const dateDue = next !== null && next <= now;\n  return statusMatch || dateDue;\n});\n\nlet message;\nif (due.length === 0) {\n  message = '✅ FOLLOW-UPS\\n\\nNo leads currently need follow-up. You are all caught up!';\n} else {\n  message = `📌 FOLLOW-UPS REQUIRED (${due.length})\\n\\n`;\n  due.forEach((lead, index) => {\n    message +=\n`${index + 1}. ${lead.Name || 'Unknown'} (${lead.Lead_ID})\nStatus: ${lead.Status || '-'}\nPriority: ${lead.Priority || '-'}\nNext Follow-up: ${lead.Next_Followup || 'Not set'}\nAction: ${lead.AI_Recommendation || '-'}\n\n`;\n  });\n  message += '👉 Reach out to these leads today.';\n}\n\nreturn [{ json: { message } }];"
      },
