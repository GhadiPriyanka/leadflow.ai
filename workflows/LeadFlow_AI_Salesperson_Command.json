    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.Lead_ID);\n\nconst leadId = String($('Code in JavaScript3').first().json.lead_id || '').trim();\n\nif (!leadId) {\n  return [{ json: { message: \"⚠️ Please provide a Lead ID. Example: /details L001\" } }];\n}\n\nconst lead = rows.find(r => String(r.Lead_ID).trim().toLowerCase() === leadId.toLowerCase());\n\nif (!lead) {\n  return [{ json: { message: `❌ Lead ${leadId} not found.` } }];\n}\n\nconst message =\n`📋 LEAD DETAILS\n\nLead ID: ${lead.Lead_ID}\nName: ${lead.Name}\nSource: ${lead.Source}\nRequirement: ${lead.Requirement}\nBudget: ${lead.Budget}\n\n🎯 AI ANALYSIS\nScore: ${lead.Score}\nPriority: ${lead.Priority}\nIntent: ${lead.Intent}\nAI Recommendation: ${lead.AI_Recommendation}\n\n📌 NEXT ACTION\n${lead.AI_Recommendation}`;\n\nreturn [{ json: { message } }];"
      },
