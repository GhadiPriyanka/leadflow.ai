    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json).filter(l => l.Lead_ID);\n\nconst total = leads.length;\n\nconst byStatus = {};\nconst byPriority = {};\n\nfor (const lead of leads) {\n  const status = String(lead.Status || 'Unknown').trim() || 'Unknown';\n  const priority = String(lead.Priority || 'Unknown').trim() || 'Unknown';\n  byStatus[status] = (byStatus[status] || 0) + 1;\n  byPriority[priority] = (byPriority[priority] || 0) + 1;\n}\n\nfunction fmt(obj) {\n  return Object.entries(obj)\n    .sort((a, b) => b[1] - a[1])\n    .map(([k, v]) => `• ${k}: ${v}`)\n    .join('\\n');\n}\n\nconst message =\n`📊 LEAD STATUS SUMMARY\n\nTotal leads: ${total}\n\nBy status:\n${fmt(byStatus)}\n\nBy priority:\n${fmt(byPriority)}`;\n\nreturn [{ json: { message } }];"
      },
