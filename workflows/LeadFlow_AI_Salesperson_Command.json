        "jsCode": "const leads = $input.all();\n\nreturn leads.map(item => {\n  const lead = item.json;\n\n  const message =\n`📋 LEAD DETAILS\n\nLead ID: ${lead.Lead_ID}\nName: ${lead.Name}\nSource: ${lead.Source}\nRequirement: ${lead.Requirement}\nBudget: ${lead.Budget}\n\n🎯 AI ANALYSIS\nScore: ${lead.Score}\nPriority: ${lead.Priority}\nIntent: ${lead.Intent}\nAI Recommendation: ${lead.AI_Recommendation}\n\n📌 NEXT ACTION\n${lead.AI_Recommendation}`;\n\n  return {\n    json: {\n      ...lead,\n      message,\n      Score: Number(lead.Score) || 0\n    }\n  };\n});"
      },
