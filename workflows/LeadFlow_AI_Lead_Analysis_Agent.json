      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"lead_id\": {\n      \"type\": \"string\"\n    },\n    \"lead_name\": {\n      \"type\": \"string\"\n    },\n    \"intent\": {\n      \"type\": \"string\"\n    },\n    \"buying_stage\": {\n      \"type\": \"string\"\n    },\n    \"urgency\": {\n      \"type\": \"string\"\n    },\n    \"score\": {\n      \"type\": \"number\"\n    },\n    \"priority\": {\n      \"type\": \"string\"\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    },\n    \"follow_up_required\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"lead_id\",\n    \"lead_name\",\n    \"intent\",\n    \"buying_stage\",\n    \"urgency\",\n    \"score\",\n    \"priority\",\n    \"recommended_action\",\n    \"follow_up_required\"\n  ]\n}"
